# 复制为 .env 并按需修改。所有配置都有安全默认值，不配置也能完整运行（AI 解读步骤自动跳过）。
# 密钥只放在服务端 .env 文件中，不要提交到版本库，不要写进代码或聊天记录。

# ---------------- 应用 ----------------
APP_NAME=基本面排雷 Agent
APP_HOST=127.0.0.1
APP_PORT=8770
APP_DEBUG=false

# ---------------- 模型接入（可选） ----------------
# 未配置 LLM_API_KEY 时：扫描照常执行，指标与规则结论全部输出，
# 但「AI 解读」与「独立核验」两个步骤不参与，报告中会明确标注"未启用"。
#
# 配置后支持任何 OpenAI 兼容协议的服务商，示例：
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
#   通义千问:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   智谱GLM:   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-5.3-flash
#   Kimi:      LLM_BASE_URL=https://api.moonshot.cn/v1    LLM_MODEL=moonshot-v1-8k
LLM_ENABLED=true
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=120
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=2000
# 独立模型批次并发数；2 可降低等待时间，若供应商限制并发可设为 1
LLM_PARALLEL_CALLS=2
LLM_TEMPERATURE=0.1

# 单次扫描的模型预算上限（元）。超过即停止调用并降级为"未启用"。
LLM_BUDGET_CNY=3.0
# 单价（元 / 百万 token），用于成本估算；不填则只累计 token，不折算金额。
# DeepSeek 参考价（以官网实时价格为准）：
LLM_PRICE_IN_CNY_PER_1M=0.0
LLM_PRICE_OUT_CNY_PER_1M=0.0
# 独立核验步骤：对"发现风险"级结论做主体/时间/语义一致性复核
LLM_VERIFY_ENABLED=true

# ---------------- 扫描范围 ----------------
# 回看的完整财年数
FISCAL_YEARS_BACK=5
# 公告检索区间（月）
ANNOUNCEMENT_MONTHS=12
# 单次扫描公告数量上限（超过会记录覆盖缺口）
MAX_ANNOUNCEMENTS=300
# 单次扫描原文下载份数上限
MAX_PDF_DOWNLOADS=25
# 单份 PDF 解析页数上限
MAX_PDF_PAGES=120
# 任务超时（秒），超时生成带缺口的部分报告
SCAN_TIMEOUT_SECONDS=900

# ---------------- 网络与安全 ----------------
HTTP_TIMEOUT=30
DOWNLOAD_TIMEOUT=120
HTTP_RETRIES=3
HTTP_BACKOFF=1.5
# 每主机请求频率上限（次/秒），对数据源保持克制
PER_HOST_RPS=2.0
# 单文件下载体积上限（字节）
MAX_FILE_BYTES=62914560
# 是否允许下载器访问内网地址（保持 false，防 SSRF）
ALLOW_PRIVATE_ADDRESS=false
# 置为 false 可完全离线运行（仅用已有数据，不发起任何外部请求，供调试用）
#ENABLE_NETWORK=true
ENABLE_PDF_PARSE=true
