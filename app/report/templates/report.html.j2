<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ security.name or '未知主体' }}（{{ security.secucode }}）排雷报告</title>
<style>
:root{
  --bg:#f8f9fa; --card:#ffffff; --line:#e5e7eb; --text:#1f2937; --muted:#6b7280;
  --faint:#94a3b8; --primary:#2563eb; --risk:#dc2626; --watch:#d97706;
  --ok:#16a34a; --info:#475569;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",'Helvetica Neue',Arial,sans-serif;
  line-height:1.7;font-size:15px;}
.wrap{max-width:960px;margin:0 auto;padding:24px 18px 64px}
header.hero{background:var(--card);border-radius:16px;padding:24px 26px;
  box-shadow:0 1px 3px rgba(15,23,42,.06),0 8px 24px rgba(15,23,42,.04);margin-bottom:18px}
.eyebrow{color:var(--faint);font-size:12px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:6px}
h1{margin:0 0 6px;font-size:26px;line-height:1.35;font-weight:700;text-wrap:balance}
.sub{color:var(--muted);font-size:14px}
.meta{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}
.meta div{font-size:13px;color:var(--muted)}
.meta b{display:block;color:var(--text);font-size:14px;font-weight:600;margin-top:2px}
section{background:var(--card);border-radius:14px;padding:22px 26px;margin-bottom:16px;
  box-shadow:0 1px 2px rgba(15,23,42,.05)}
/* 大栏目：淡蓝色带 + 蓝色左标条；小栏目：浅灰带 + 细蓝左标条 */
section h2{margin:0 0 14px;padding:10px 16px;background:#eff6ff;color:#1e3a8a;
  border-left:4px solid #2563eb;border-radius:0 8px 8px 0;font-size:17px;font-weight:700;
  display:flex;align-items:baseline}
section h2 .idx{color:#2563eb;font-weight:650;margin-right:8px;font-variant-numeric:tabular-nums}
section h3{margin:14px 0 8px;padding:5px 12px;background:#f1f5f9;color:#334155;
  border-left:3px solid #93c5fd;border-radius:0 6px 6px 0;font-size:14px;font-weight:600;
  display:flex;align-items:baseline;gap:6px;flex-wrap:wrap}
section h3 span{color:var(--muted);font-weight:400;font-size:12.5px}
.hint{color:var(--muted);font-size:13px;margin:0 0 16px}
/* 02 矩阵"说明"列：长说明折叠 */
.cell-fold{margin:4px 0 0}
.cell-fold>summary{font-size:12px;cursor:pointer}
.badge{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;
  font-weight:600;line-height:1.7;white-space:nowrap}
.badge.risk{background:#fee2e2;color:#991b1b}
.badge.watch{background:#fef3c7;color:#92400e}
.badge.normal{background:#dcfce7;color:#166534}
.badge.insufficient{background:#e5e7eb;color:#4b5563}
.badge.na{background:#f1f5f9;color:#64748b}
.sev-high{color:#991b1b}.sev-mid{color:#92400e}.sev-low{color:#1d4ed8}.sev-unknown{color:#6b7280}
table{width:100%;border-collapse:collapse;font-size:13.5px}
th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--muted);font-weight:600;font-size:12.5px;background:#f8fafc}
td.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.finding{border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:12px}
.finding.risk{border-left:4px solid var(--risk)}
.finding.watch{border-left:4px solid var(--watch)}
.finding.normal{border-left:4px solid var(--ok)}
.finding.insufficient{border-left:4px solid var(--faint)}
.finding.na{border-left:4px solid #cbd5e1}
.finding h4{margin:0 0 8px;font-size:15px;font-weight:650}
.finding .row{margin:6px 0;font-size:13.5px}
.finding .label{color:var(--muted);font-weight:600;margin-right:6px}
.quote{background:#f8fafc;border-left:3px solid var(--primary);padding:10px 12px;margin:8px 0;
  font-size:13px;color:var(--info);white-space:pre-wrap;word-break:break-word;border-radius:0 6px 6px 0}
ul{margin:6px 0;padding-left:20px}
li{margin:4px 0;font-size:13.5px}
details{margin-top:10px}
summary{cursor:pointer;font-size:13px;color:var(--primary);font-weight:600;outline:none}
footer{color:var(--faint);font-size:12px;text-align:center;padding:26px 12px}
a{color:var(--primary);text-decoration:none;word-break:break-all}
a:hover{text-decoration:underline}
.warn{background:#fffbeb;border:1px solid #fde68a;border-radius:10px;padding:12px 14px;
  font-size:13px;color:#92400e;margin-bottom:12px}
.info{background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:12px 14px;
  font-size:13px;color:#1e40af;margin-bottom:12px}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}
.score-box{display:flex;align-items:center;gap:20px;flex-wrap:wrap;border:1px solid var(--line);
  border-radius:12px;padding:16px 20px;margin:0 0 12px;background:#f8fafc}
.score-main{display:flex;align-items:center;gap:12px}
.score-num{font-size:44px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
.score-grade{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;
  border-radius:10px;font-size:20px;font-weight:700;color:#fff}
.score-grade.g-a{background:#16a34a}.score-grade.g-b{background:#2563eb}
.score-grade.g-c{background:#d97706}.score-grade.g-d{background:#ea580c}
.score-grade.g-e{background:#dc2626}
.score-side{flex:1;min-width:240px}
.score-label{font-weight:600;font-size:14.5px}
.score-comp{color:var(--muted);font-size:13px;margin-top:3px;line-height:1.6}
.score-note{color:var(--faint);font-size:12px;margin:6px 0 14px}
.tag{display:inline-block;background:#f1f5f9;color:#475569;border-radius:6px;
  padding:1px 7px;font-size:12px;margin-right:6px}
.toc{list-style:none;padding:0;margin:0}
.toc li{display:flex;align-items:baseline;gap:10px;padding:7px 0;border-bottom:1px solid #f1f5f9;margin:0}
.toc li:last-child{border-bottom:none}
.toc .no{color:var(--faint);font-weight:600;font-size:13px;font-variant-numeric:tabular-nums;min-width:22px}
.toc a{color:var(--text);font-weight:600;font-size:14px;text-decoration:none}
.toc a:hover{color:var(--primary);text-decoration:underline}
.toc .desc{color:var(--muted);font-size:12.5px}
section{scroll-margin-top:16px}
@media (max-width:640px){
  body{background:#eef2f7;font-size:15px;line-height:1.72}
  .wrap{padding:0 0 40px;max-width:none}
  header.hero,section{border-radius:0;margin-bottom:10px;box-shadow:0 1px 3px rgba(15,23,42,.06)}
  header.hero{padding:20px 18px 18px;border-top:4px solid var(--primary)}
  .eyebrow{font-size:11px;letter-spacing:.1em;margin-bottom:7px}
  h1{font-size:23px;line-height:1.32;margin-bottom:8px}
  .sub{font-size:13.5px;line-height:1.65}
  .data-basis{margin-top:12px!important;padding:10px 12px;background:#f8fafc;border-radius:10px;color:#526071}
  .meta{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px;padding-top:14px}
  .meta div{font-size:12px}
  .meta b{font-size:13.5px;overflow-wrap:anywhere}
  section{padding:16px 14px}
  section h2{margin-bottom:12px;padding:9px 12px;font-size:16px;line-height:1.45;border-radius:0 8px 8px 0}
  section h3{margin:16px 0 10px;padding:8px 10px;font-size:14px;line-height:1.45}
  section h3 span{display:block;flex-basis:100%;font-size:12px;line-height:1.5;margin-top:2px}
  .hint{font-size:13.5px;line-height:1.7;margin-bottom:14px}
  .toc{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .toc li{align-items:center;gap:7px;padding:10px;border:1px solid var(--line);border-radius:10px;background:#f8fafc}
  .toc li:last-child{border-bottom:1px solid var(--line)}
  .toc .no{min-width:auto;font-size:12px;color:var(--primary)}
  .toc a{font-size:13.5px;line-height:1.35;word-break:normal}
  .toc .desc{display:none}
  .score-box{align-items:stretch;gap:12px;padding:14px;background:linear-gradient(135deg,#f8fafc,#eff6ff)}
  .score-main{gap:10px}
  .score-num{font-size:40px}
  .score-grade{width:34px;height:34px;font-size:18px}
  .score-side{min-width:0;flex-basis:100%}
  .score-label{font-size:14px;line-height:1.5}
  .score-comp{font-size:12.5px;line-height:1.65}
  .score-note{font-size:12px;line-height:1.6}
  .warn,.info{padding:12px;font-size:13.5px;line-height:1.7}
  .badge{white-space:normal;max-width:100%;line-height:1.55;padding:3px 8px;text-align:left}

  /* 五列表格在手机端改为字段卡片，避免状态和说明被压成窄列。 */
  table.responsive-table{display:block;width:100%;font-size:13.5px;border-collapse:separate}
  table.responsive-table thead{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  table.responsive-table tbody{display:block;width:100%}
  table.responsive-table tr{display:block;width:100%;margin:0 0 10px;padding:0 12px 4px;border:1px solid var(--line);border-radius:12px;background:#fff;overflow:hidden;box-shadow:0 1px 2px rgba(15,23,42,.03)}
  table.responsive-table td{display:grid;grid-template-columns:58px minmax(0,1fr);gap:8px;width:100%;min-width:0!important;padding:8px 0;border:0;border-bottom:1px dashed #e8edf3;vertical-align:top;overflow-wrap:anywhere}
  table.responsive-table td::before{content:attr(data-label);color:var(--muted);font-size:12px;font-weight:600;line-height:1.65}
  table.responsive-table td[data-label="说明"],table.responsive-table td[data-label="发现"]{display:block}
  table.responsive-table td[data-label="说明"]::before,table.responsive-table td[data-label="发现"]::before{display:block;margin-bottom:4px}
  table.responsive-table td:first-child{display:block;margin:0 -12px 2px;padding:10px 12px;background:#f8fafc;border-bottom:1px solid var(--line);font-size:14px}
  table.responsive-table td:first-child::before{display:none}
  table.responsive-table td:last-child{border-bottom:0}
  table.responsive-table td .mono{font-size:11.5px}
  table.responsive-table td .badge{justify-self:start}
  .cell-fold{margin-top:5px}
  .cell-fold>summary{min-height:auto;padding:5px 0;border:0;background:transparent;font-size:12.5px}

  .finding{padding:13px 12px;margin-bottom:10px;border-radius:10px}
  .finding h4{display:flex;align-items:center;flex-wrap:wrap;gap:6px;margin-bottom:8px;font-size:15px;line-height:1.5}
  .finding .row{margin:0;padding:8px 0;border-bottom:1px solid #f1f5f9;font-size:14px;line-height:1.7;overflow-wrap:anywhere}
  .finding .row:last-child{border-bottom:0}
  .finding .label{display:block;margin:0 0 2px;color:#64748b;font-size:12px;line-height:1.5}
  .quote{padding:10px;margin:8px 0;font-size:13.5px;line-height:1.7}
  .finding details>summary,#sec-04>details>summary{display:flex;align-items:center;min-height:44px;padding:9px 11px;border:1px solid var(--line);border-radius:9px;background:#f8fafc;font-size:13.5px}
  .finding details[open]>summary,#sec-04>details[open]>summary{border-color:#bfdbfe;background:#eff6ff}
  #sec-04>details{margin-top:8px}
  ul{padding-left:19px}
  li{font-size:13.5px;line-height:1.7}
  footer{padding:20px 18px;font-size:11.5px;line-height:1.7}
}
@media (max-width:360px){
  header.hero{padding-left:15px;padding-right:15px}
  h1{font-size:21px}
  section{padding-left:12px;padding-right:12px}
  .meta,.toc{grid-template-columns:1fr}
}
@media print{
  body{background:#fff}
  section,header.hero{box-shadow:none;border:1px solid #e5e7eb;page-break-inside:avoid}
  details{display:block}
  details summary{display:none}
  table.responsive-table{display:table;width:100%;border-collapse:collapse;font-size:13.5px}
  table.responsive-table thead{position:static;width:auto;height:auto;padding:0;margin:0;overflow:visible;clip:auto;white-space:normal;border:0}
  table.responsive-table tbody{display:table-row-group;width:auto}
  table.responsive-table tr{display:table-row;width:auto;margin:0;padding:0;border:0;border-radius:0;background:transparent;overflow:visible;box-shadow:none}
  table.responsive-table td,table.responsive-table td:first-child{display:table-cell;width:auto;min-width:0;margin:0;padding:9px 10px;background:transparent;border:0;border-bottom:1px solid var(--line);font-size:13.5px}
  table.responsive-table td::before{display:none}
}
</style>
</head>
<body>
<div class="wrap">
{% if payload.rule_version != current_rule_version %}<div class="info">此报告由旧版规则 {{ payload.rule_version }} 生成。查看修复后的计算结果，请重新扫描该证券。</div>{% endif %}

<header class="hero">
  <div class="eyebrow">A 股 / 港股基本面排雷报告</div>
  <h1>{{ security.name }}（{{ security.secucode }}）排雷报告</h1>
  <div class="sub">
    {{ security.exchange }}{% if security.industry %} · {{ security.industry }}{% endif %}
     · 报表币种 {{ metrics.currency }}{% if security.currency %} · 证券交易币种 {{ security.currency }}{% endif %}
    {% if industry_pack and industry_pack != 'general' %} · 适用 {{ industry_pack }} 行业规则包{% endif %}
  </div>
  <div class="sub data-basis" style="margin-top:4px">
    数据基础：{{ data_scope.announcement_range or '近 12 个月' }}公告 {{ data_scope.announcement_fetched or 0 }} 条 ·
    原文 {{ data_scope.documents_downloaded or 0 }} 份 · 证据 {{ data_scope.evidence_count or 0 }} 条
    （{{ data_scope.evidence_verified or 0 }} 条通过原文复核）
  </div>
  <div class="meta">
    <div>扫描时间<b>{{ scan.started_at or '—' }}</b></div>
    <div>最新财报期<b>{{ data_scope.latest_period_label or data_scope.latest_period or '—' }}</b></div>
  </div>
</header>

{# ---------- 报告目录 ---------- #}
<section>
  <h2>报告目录</h2>
  <ul class="toc">
    <li><span class="no">01</span><a href="#sec-01">风险总览</a><span class="desc">这家公司风险有多大、扣了多少分、最严重的几条问题</span></li>
    <li><span class="no">02</span><a href="#sec-02">逐项检查结果</a><span class="desc">财务、偿债、治理、监管、经营 5 个角度的逐条结论</span></li>
    <li><span class="no">03</span><a href="#sec-03">问题详情与原文</a><span class="desc">每条结论的详细理由和公告原文（默认折叠）</span></li>
    <li><span class="no">04</span><a href="#sec-04">数据来源与算法</a><span class="desc">数据从哪来、怎么算的、有什么局限</span></li>
  </ul>
</section>

{# ---------- 1. 执行摘要 ---------- #}
<section id="sec-01">
  <h2><span class="idx">01</span>风险总览</h2>
  <p class="hint">最重要的结论一页速览；点击检查项名称跳转到第 03 节查看完整证据链。</p>

  <div class="score-box">
    <div class="score-main">
      <span class="score-num">{{ risk_score.score }}</span>
      <span class="score-grade g-{{ risk_score.grade|lower }}">{{ risk_score.grade }}</span>
    </div>
    <div class="score-side">
      <div class="score-label">风险信号评分 · {{ risk_score.label }}</div>
      <div class="score-comp">
        基础分 100 · 发现风险 −{{ risk_score.risk_deduction }}（{{ risk_score.risk_comp }}）
        · 需要关注 −{{ risk_score.watch_deduction }}（{{ risk_score.watch_comp }}）
      </div>
    </div>
  </div>
  <p class="score-note">评分为检查项扣分加权汇总，反映风险信号密度，不代表投资价值或违约概率。</p>

  <p class="hint">适用检查 {{ coverage.applicable }} 项，已形成判断 {{ coverage.evaluated }} 项，
    <b>{{ summary.insufficient_count }}</b> 项数据不足。扫描状态：{{ scan.status or '未记录' }}。
    原文存在性复核通过不等于已确认整条结论。</p>
  {% if summary.risk_count or summary.watch_count %}
  <div class="warn">
    本次在已获取资料范围内发现 <b>{{ summary.risk_count }}</b> 项风险、
    <b>{{ summary.watch_count }}</b> 项需关注事项，
    另有 <b>{{ summary.insufficient_count }}</b> 项因数据不足无法判断。
    最高风险等级：<b>{{ summary.highest_severity }}</b>。
  </div>
  {% else %}
  <div class="info">
    本次未触发风险或关注级别的检查项。请注意：这<b>不等于</b>该公司不存在风险，
    结论仅在已覆盖资料范围内成立。
  </div>
  {% endif %}

  {% if summary.top_findings %}
  <h3>发现清单</h3>
  <table class="responsive-table" aria-label="重点发现清单">
    <thead><tr><th style="width:22%">检查项</th><th style="width:12%">结论</th><th style="width:9%">严重度</th><th>发现了什么</th></tr></thead>
    <tbody>
    {% for f in summary.top_findings %}
      <tr>
        <td data-label="检查项"><b><a href="#ev-{{ f.rule_id }}">{{ f.name }}</a></b><br><span class="mono" style="color:#94a3b8">{{ f.rule_id }}</span></td>
        <td data-label="结论"><span class="badge {{ status_class.get(f.status,'na') }}">{{ f.status }}</span></td>
        <td data-label="严重度" class="{{ severity_class.get(f.severity,'sev-unknown') }}">{{ f.severity }}</td>
        <td data-label="发现">{{ f.finding }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>

{# ---------- 2. 五个维度检查矩阵 ---------- #}
<section id="sec-02">
  <h2><span class="idx">02</span>逐项检查结果</h2>
  <p class="hint">仅列出已形成判断的检查项；"不适用"项已省略。</p>
  {% for dim in dimensions %}
  {% set visible = dim.results|rejectattr('status','in',['不适用','数据不足，无法判断'])|list %}
  {% if visible %}
  <h3>{{ dim.dimension }} <span style="font-weight:400;color:#94a3b8;font-size:12.5px">{{ dimension_desc.get(dim.dimension,'') }}</span></h3>
  <table class="responsive-table" aria-label="{{ dim.dimension }}检查结果">
    <thead><tr><th style="width:20%">检查项</th><th style="width:11%">结论</th><th style="width:9%">严重度</th><th>说明</th><th style="width:14%">证据</th></tr></thead>
    <tbody>
    {% for r in visible %}
      <tr>
        <td data-label="检查项"><b>{{ r.name }}</b><br><span class="mono" style="color:#94a3b8">{{ r.rule_id }}</span></td>
        <td data-label="结论"><span class="badge {{ status_class.get(r.status,'na') }}">{{ r.status }}</span></td>
        <td data-label="严重度" class="{{ severity_class.get(r.severity,'sev-unknown') }}">{{ r.severity }}</td>
        <td data-label="说明">{{ r.finding }}{% if r.why %}{% if r.why|length > 60 %}
          <details class="cell-fold"><summary>展开说明（{{ r.why|length }} 字）</summary>
            <span style="color:#6b7280">{{ r.why }}</span></details>
          {% else %}<br><span style="color:#6b7280">{{ r.why }}</span>{% endif %}{% endif %}</td>
        <td data-label="证据">{% if r.evidence_ids %}{% if r.status in ('发现风险','需要关注') %}<a href="#ev-{{ r.rule_id }}">{{ r.evidence_ids|length }} 条</a>{% else %}{{ r.evidence_ids|length }} 条（见原文，无风险卡片）{% endif %}{% else %}—{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
  {% endfor %}
</section>

{# ---------- 3. 风险详情与原始证据 ---------- #}
<section id="sec-03">
  <h2><span class="idx">03</span>问题详情与原文</h2>
  <p class="hint">每条结论按“发现了什么 → 为什么值得关注 → 证据 → 当前是否存在 → 缓解因素 → 还需核实”组织；原始证据默认折叠，点击展开。</p>
  {% for dim in dimensions %}
    {% set risky = dim.results|selectattr('status','in',['发现风险','需要关注'])|list %}
    {% if risky %}
    <h3>{{ dim.dimension }}</h3>
    {% for r in risky %}
    <div class="finding {{ status_class.get(r.status,'na') }}" id="ev-{{ r.rule_id }}">
      <h4>{{ r.name }} <span class="badge {{ status_class.get(r.status,'na') }}">{{ r.status }}</span>
        <span class="badge" style="background:#f1f5f9;color:#475569">{{ r.severity }}</span></h4>
      <div class="row"><span class="label">发现了什么</span>{{ r.finding }}</div>
      {% if r.why %}<div class="row"><span class="label">为什么值得关注</span>{{ r.why }}</div>{% endif %}
      <div class="row"><span class="label">证据支持程度</span>{{ r.strength }}</div>
      {% if r.evidence_ids %}
      <details>
        <summary>展开原始证据（{{ r.evidence_ids|length }} 条）</summary>
        <div class="row"><span class="label">证据</span>
          {% for eid in r.evidence_ids %}{% set ev = evidence_map.get(eid) %}{% if ev %}
            <div class="quote">
              {{ ev.quote }}<br>
              <span style="color:#94a3b8">
                — {{ ev.title }} · {{ ev.location }} · {{ ev.publish_date }} · 来源 {{ ev.source }}
                · 指纹 <span class="mono">{{ ev.fingerprint }}</span>
                {% if ev.verified %}· 已复核{% else %}· <b style="color:#b45309">复核未通过</b>{% endif %}
                {% if safe_url(ev.url) %} · <a href="{{ safe_url(ev.url) }}" target="_blank" rel="noopener">原文</a>{% endif %}
              </span>
            </div>
          {% endif %}{% endfor %}
        </div>
      </details>
      {% else %}
      <div class="row"><span class="label">证据</span><span style="color:#b45309">该项结论未绑定原文证据，需人工核实</span></div>
      {% endif %}
      <div class="row"><span class="label">当前是否仍存在</span>
        {% if r.still_effective is sameas true %}是，最新资料中仍然成立
        {% elif r.still_effective is sameas false %}否，已有后续进展表明该事项已解除或缓解
        {% else %}无法从已获取资料判断（需查看后续公告）{% endif %}</div>
      {% if r.mitigations %}
      <div class="row"><span class="label">缓解因素</span>
        <ul style="margin:2px 0">{% for m in r.mitigations %}<li>{{ m }}</li>{% endfor %}</ul></div>
      {% endif %}
      {% if r.to_verify %}
      <div class="row"><span class="label">还需核实</span>
        <ul style="margin:2px 0">{% for v in r.to_verify %}<li>{{ v }}</li>{% endfor %}</ul></div>
      {% endif %}
      <div class="row" style="color:#94a3b8;font-size:12px">
        规则 {{ r.rule_id }} · 解释来源：{% if r.ai_interpreted %}模型解读（基于上述证据）{% else %}规则模板（本项未获得有效模型解读）{% endif %}
      </div>
    </div>
    {% endfor %}
    {% endif %}
  {% endfor %}
</section>

{# ---------- 4. 来源与方法（极简） ---------- #}
<section id="sec-04">
  <h2><span class="idx">04</span>数据来源与算法</h2>
  <p class="hint">
    AI 解读：{% if ai.usage.available %}已启用（{{ ai.usage.model or '已配置模型' }}，{{ ai.usage.calls or 0 }} 次模型调用{% if ai.usage.cache_hits %}，{{ ai.usage.cache_hits }} 次缓存复用{% endif %}，{{ '%.4f'|format(ai.usage.spent_cny or 0) }} 元）{% else %}未启用——{{ ai.usage.reason or '未配置密钥' }}，结论解释为规则模板文案{% endif %}。
    计算口径：期间损益与现金流按各自财年累计，同比只与上一年同期、同币种同口径比较；
    货币资金扣除受限资金后才计入可用现金，单列的现金及等价物不重复扣除受限现金；缺失口径不估算。
  </p>
  {% if gaps %}<div class="warn"><b>本次资料与执行缺口</b><ul>{% for gap in gaps %}<li>{{ gap }}</li>{% endfor %}</ul></div>{% endif %}
  {% if missing_data %}<details><summary>数据不足的检查（{{ missing_data|length }} 项）</summary>
    <ul>{% for item in missing_data %}<li>{{ item.rule_id }} {{ item.name }}：{{ item.reason }}</li>{% endfor %}</ul></details>{% endif %}
  {% if notes %}<details><summary>计算口径说明</summary><ul>{% for note in notes %}<li>{{ note }}</li>{% endfor %}</ul></details>{% endif %}
  {% if ai.notes or ai.usage.failures or ai.verification %}<details><summary>AI 执行与核验详情</summary>
    <ul>{% for note in ai.notes %}<li>{{ note }}</li>{% endfor %}
    {% for failure in ai.usage.failures %}<li>未完整执行：{{ failure }}</li>{% endfor %}
    {% for item in ai.verification %}<li>{{ item.rule_id }}：{{ item.verdict }}；{{ item.reason }}；{{ item.suggested_status }}</li>{% endfor %}</ul></details>{% endif %}
  {% if method.limitations %}<details><summary>资料范围与方法限制</summary><ul>{% for item in method.limitations %}<li>{{ item }}</li>{% endfor %}</ul></details>{% endif %}
  <p class="hint">{{ method.disclaimer or '本报告由程序计算指标、模型解释异常，证据支持程度与核验结果分别标注，不构成投资建议。' }}</p>
</section>

<footer>
  报告 ID {{ payload.task_id }} · 生成于 {{ rendered_at }} · 报告版本 v{{ payload.report_version }} · 规则版本 v{{ payload.rule_version }}<br>
  本报告由程序计算指标、模型解释异常，证据支持程度与核验结果分别标注，不构成投资建议。
</footer>

</div>
<script>
// 打印时自动展开全部折叠区（原文证据），打印后恢复原状。
// 锚点跳转（如检查矩阵的"N 条"链接）时自动展开目标所在的折叠区。内联脚本，无外部依赖。
(function(){
  function openAll(){document.querySelectorAll('details').forEach(function(d){if(!d.open){d.setAttribute('data-was-closed','');d.open=true}})}
  function restore(){document.querySelectorAll('details[data-was-closed]').forEach(function(d){d.open=false;d.removeAttribute('data-was-closed')})}
  window.addEventListener('beforeprint',openAll);
  window.addEventListener('afterprint',restore);
  function openHashTarget(){var t=document.getElementById(location.hash.slice(1));if(t){t.querySelectorAll('details').forEach(function(d){d.open=true})}while(t){if(t.tagName==='DETAILS'){t.open=true}t=t.parentElement}}
  window.addEventListener('hashchange',openHashTarget);
  openHashTarget();
})();
</script>
</body>
</html>
